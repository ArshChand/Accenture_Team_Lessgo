  "shockIndexCeiling": {
    "neonate": 2.0,
    "infant": 1.6,
    "toddler": 1.4,
    "child": 1.2,
    "adolescent": 1.0,
    "adult": 0.9,
    "geriatric": 0.9,
    "advanced_geriatric": 0.9,
    "_note": "Shock index is heart rate over systolic pressure, so it is naturally high in children, who run fast hearts and low pressures. A single adult ceiling of 0.9 calls every healthy toddler shocked. These follow the age-adjusted paediatric shock index (SIPA) convention.",
    "_examples": "A well 3-year-old at HR 120 / SBP 96 scores 1.25 — normal here, alarming against an adult ceiling. A shocked 3-year-old at HR 165 / SBP 80 scores 2.06 and still fires."
  },

  "paediatricSystolicFormula": {
    "enabled": true,
    "intercept": 70,
    "slopePerYear": 2,
    "minAgeYears": 1,
    "maxAgeYears": 10,
    "aboveMaxAgeFloor": 90,
    "belowMinAgeFloor": 70,
    "lowOffset": 10,
    "appliesToBands": ["toddler", "child"],
    "note": "Standard APLS hypotension floor, 70 + (2 x age in years) for ages 1-10."
  },

  "safeWaitMinutes": {
    "1": 0,
    "2": 10,
    "3": 30,
    "4": 60,
    "5": 120
  },

  "decay": {
    "amberRatio": 0.6,
    "reassessRatio": 0.8
  },

  "confidence": {
    "weights": {
      "completeness": 0.3,
      "modelMargin": 0.35,
      "inputReliability": 0.25,
      "ageBandSupport": 0.1
    },
    "thresholds": {
      "high": 0.75,
      "moderate": 0.55
    },
    "surgeEscalationThreshold": 0.62,
    "escalationFloorESI": 2,

    "useModelEscalation": true,
    "escalationTau": 0.4,
    "_escalationNote": "The model escalates when the cumulative probability of something worse reaches escalationTau, capped at its most likely class so the rule can only ever raise urgency. This was briefly switched off after it compressed a 20-patient demonstration roster onto ESI 2; measuring it against 1500 held-out encounters showed that cost a third of the system's under-triage performance (11.9% with it off against 8.6% at tau 0.4). The threshold, not the mechanism, was the right control. See docs/safety-case.md and docs/fusion-evaluation.json.",
    "_escalationTauGuidance": "Lower escalates more readily. Measured on the reference model: 0.30 gives 6.2% under-triage against 45.5% over-triage; 0.40 gives 8.6% against 40.7%; 0.50 gives 10.7% against 36.4%. Above roughly 0.6 the rule stops firing at all. This is a capacity decision as much as a clinical one — a department with spare beds can afford to sit lower than one already full."
  },

  "modelSupportByBand": {
    "neonate": 0.45,
    "infant": 0.6,
    "toddler": 0.72,
    "child": 0.8,
    "adolescent": 0.82,
    "adult": 0.95,
    "geriatric": 0.85,
    "advanced_geriatric": 0.7
  },

  "ruleOverrides": [],

  "surge": {
    "baselineArrivalsPerHour": 8,
    "surgeMultiplier": 2,
    "queuePerNurseThreshold": 6,
    "esi3SubBandingEnabled": true,
    "lowAcuityReassessIntervalMs": 600000
  }
}

  "paediatricSystolicFormula": {
    "enabled": true,
    "intercept": 70,
    "slopePerYear": 2,
    "minAgeYears": 1,
    "maxAgeYears": 10,
    "aboveMaxAgeFloor": 90,
    "belowMinAgeFloor": 70,
    "lowOffset": 10,
    "appliesToBands": ["toddler", "child"],
    "note": "Standard APLS hypotension floor, 70 + (2 x age in years) for ages 1-10."
  },

  "safeWaitMinutes": {
    "1": 0,
    "2": 10,
    "3": 30,
    "4": 60,
    "5": 120
  },

  "decay": {
    "amberRatio": 0.6,
    "reassessRatio": 0.8
  },

  "confidence": {
    "weights": {
      "completeness": 0.3,
      "modelMargin": 0.35,
      "inputReliability": 0.25,
      "ageBandSupport": 0.1
    },
    "thresholds": {
      "high": 0.75,
      "moderate": 0.55
    },
    "surgeEscalationThreshold": 0.62,
    "escalationFloorESI": 2
  },

  "modelSupportByBand": {
    "neonate": 0.45,
    "infant": 0.6,
    "toddler": 0.72,
    "child": 0.8,
    "adolescent": 0.82,
    "adult": 0.95,
    "geriatric": 0.85,
    "advanced_geriatric": 0.7

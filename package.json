{
  "name": "triagehandler",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "TriageHandler — a zero-friction, multi-modal triage assistant. Team Lessgo, Accenture Innovation Challenge 2026, PatientTriage.ai track (Round 2 prototype).",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently -n backend,frontend,ml -c blue,green,magenta \"npm:dev:backend\" \"npm:dev:frontend\" \"npm:dev:ml\"",
    "dev:backend": "npm run dev --workspace backend",
    "dev:frontend": "npm run dev --workspace frontend",
    "dev:ml": "cd ml-service && python3 -m uvicorn app.main:app --port 8000 --reload",
    "seed": "npm run seed --workspace backend",
    "demo:surge": "npm run demo:surge --workspace backend",
    "demo:override": "npm run demo:override --workspace backend",
    "test": "npm run test --workspace backend"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  },
  "engines": {
    "node": ">=20"
  }
}

{
  "name": "triagehandler",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "TriageHandler — a zero-friction, multi-modal triage assistant. Team Lessgo, Accenture Innovation Challenge 2026, PatientTriage.ai track (Round 2 prototype).",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently -n backend,frontend,ml -c blue,green,magenta \"npm:dev:backend\" \"npm:dev:frontend\" \"npm:dev:ml\"",
    "dev:backend": "npm run dev --workspace backend",
    "dev:frontend": "npm run dev --workspace frontend",
    "dev:ml": "cd ml-service && node ../scripts/py.mjs -m uvicorn app.main:app --port 8000 --reload",
    "seed": "npm run seed --workspace backend",
    "demo:surge": "npm run demo:surge --workspace backend",
    "demo:override": "npm run demo:override --workspace backend",
    "demo:decay": "node backend/scripts/liveQueueCheck.mjs",
    "evaluate": "cd ml-service && node ../scripts/py.mjs -m app.export_eval_set 1500 && cd ../backend && node scripts/evaluateFusion.js",
    "test": "npm run test --workspace backend",
    "test:ml": "cd ml-service && node ../scripts/py.mjs -m pytest tests/ -q"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "socket.io-client": "^4.8.3"
  }
}
